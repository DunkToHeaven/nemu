# ============================================================
# Nemu — konfigurasi lokal
# ============================================================
# File ini TIDAK di-commit (.gitignore: .env*.local).
# Salin dari .env.example lalu sesuaikan.
# ============================================================

# Sumber data: "true" = PostgreSQL, kosong = lapisan mock (demo tanpa DB)
DATABASE_ENABLED=false

# Koneksi PostgreSQL
DATABASE_URL=postgres://postgres@127.0.0.1:5432/nemu
DATABASE_POOL_MAX=10

# Kunci enkripsi token integrasi (AES-256-GCM).
# WAJIB diganti di produksi. Buat dengan: openssl rand -base64 32
APP_SECRET=

# Izinkan ganti peran lewat panel dev. JANGAN aktifkan di produksi.
ALLOW_ROLE_SWITCH=true

# Integrasi Google (kosongkan bila belum dipakai)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/integrations/google/callback

# --- Supabase (produksi / Vercel) -------------------------------------------
# Free plan tidak punya IPv4 untuk db.<ref>.supabase.co. Pakai transaction
# pooler port 6543. Password berisi karakter khusus -> percent-encode.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DATABASE_POOL_MAX=5
# TENANT_POOL_MAX=2
